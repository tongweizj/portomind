# 必需：Worker 使用的 MongoDB，与 ../server 共享同一数据库
MONGO_URI=mongodb://127.0.0.1:27017/portomind_dev

# 日志
LOG_LEVEL=info
LOG_DIR=./logs

# 调度所有权：同一时间只能有一个进程设置 SCHEDULER_ENABLED=true。
# 若本 Worker 接管调度，../server 进程必须设 SCHEDULER_ENABLED=false。
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Toronto
MARKET_TIMEZONE=America/Toronto

# 价格同步 cron 表达式（默认每天 03:00，按 SCHEDULER_TIMEZONE）
PRICE_SYNC_CRON=0 3 * * *

# 健康检查 cron 表达式（默认每天 03:30，在价格同步完成后运行）
HEALTH_CHECK_CRON=30 3 * * *

# 完整性检查发现缺口后是否自动调用 historySync 补全（默认开启；设 false 关闭）
INTEGRITY_AUTO_REPAIR=true

# 自动补全只覆盖「最近 N 天」内的缺失区间，更早的缺口延后（避免首次运行超大规模回补）
INTEGRITY_REPAIR_MAX_DAYS=30
