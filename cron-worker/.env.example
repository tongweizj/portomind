# 必需：cron-worker 使用的 MongoDB，与 ../server 共享同一数据库。
MONGO_URI=mongodb://127.0.0.1:27017/portomind_dev

# 日志
LOG_LEVEL=info
LOG_MAX_FILES=60d
# 日志目录（可选）：不设置时默认写入**仓库根 logs/**（由 shared 内以 __dirname 推导的绝对路径，
# 与 server 共用同一目录），这样 server 的 GET /api/logs/tasks 能读到本进程的任务日志。
# 如需自定义再解开下面一行；相对路径将以进程 cwd 解析，请确保两侧指向同一目录。
# LOG_DIR=../logs

MARKET_TIMEZONE=America/Toronto
MARKET_DATA_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────
# 调度：cron-worker 是 PortoMind **唯一**的调度所有者（ADR-002）。
# server 进程不注册任何 cron，因此不再存在「二选一」的所有权问题。
# ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Toronto

# 5 类定时任务（cron 表达式均按 SCHEDULER_TIMEZONE 解释）
PRICE_SYNC_CRON=0 3 * * *           # 1) 价格同步，每天 03:00
HEALTH_CHECK_CRON=30 3 * * *        # 2) 完整性检查，每天 03:30（价格同步之后）
ALERT_EVAL_CRON=0 4 * * *           # 3) 提醒评估，每天 04:00
FX_SYNC_CRON=30 9 * * *             # 4) 汇率同步，每天 09:30（央行中间价公布后）
REBALANCE_CHECK_CRON=0 0 * * *      # 5) 再平衡分发，每天 00:00（按各组合 rebalanceSchedule 判断是否到期）

# 完整性检查发现缺口后是否自动调用 historySync 补全（默认开启；设 false 关闭）
INTEGRITY_AUTO_REPAIR=true

# 自动补全只覆盖「最近 N 天」内的缺失区间，更早的缺口延后（避免首次运行超大规模回补）
INTEGRITY_REPAIR_MAX_DAYS=30
