{
  "name": "@portomind/server",
  "version": "1.0.0",
  "description": "PortoMind REST API（Express + MongoDB）。业务引擎来自 @portomind/shared，本进程不持有任何 cron 调度。",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/integration/*.test.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "sync:prices": "node tasks/dailySync.js",
    "seed:baseline": "node scripts/seedBaseline.js",
    "validate": "node scripts/validate.js",
    "verify:baseline": "node scripts/verifyBaseline.js",
    "verify": "npm run validate && npm run verify:baseline",
    "e2e:auth": "node scripts/e2e-auth-058.cjs"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest",
    "api",
    "mongodb"
  ],
  "author": "bezkoder",
  "license": "MIT",
  "dependencies": {
    "@portomind/shared": "*",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "mongoose": "^6.13.11",
    "on-finished": "^2.4.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
