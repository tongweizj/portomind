    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "minimist": "^1.2.8",
    "mongoose": "^6.13.11",
    "node-cron": "^4.6.0",
    "on-finished": "^2.4.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yahoo-finance2": "^2.14.2"
