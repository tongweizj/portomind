# 必需：API（含 seed / baseline 校验 / 手动价格同步 CLI）使用的 MongoDB。
MONGO_URI=mongodb://127.0.0.1:27017/portomind_dev

# 可选 server 设置。
PORT=8080
LOG_LEVEL=info
LOG_MAX_FILES=60d
MARKET_TIMEZONE=America/Toronto
MARKET_DATA_TIMEOUT_MS=10000

# 日志目录（可选）：不设置时默认写入**仓库根 logs/**（由 shared 内以 __dirname 推导的绝对路径，
# 与 cron-worker 共用同一目录），这样 GET /api/logs/tasks 能读到 cron-worker 产生的任务日志。
# 如需自定义再解开下面一行；相对路径将以进程 cwd 解析，请确保两侧指向同一目录。
# LOG_DIR=../logs

# CORS 白名单（TASK-058）：逗号分隔的允许来源；已与认证同批收敛为白名单 + credentials。
# - 开发默认（未配置时）放行 localhost:5173 / 127.0.0.1:5173 / 192.168.2.110:9000
# - 生产（NODE_ENV=production）**必须**配置本变量，否则启动 fail-fast
CORS_ORIGINS=http://localhost:5173

# TASK-058 账号与访问控制：
# - SESSION_TTL_DAYS：会话绝对过期天数（默认 7，不做滑动续期）
# - COOKIE_SECURE：会话 cookie 是否要求 HTTPS（未设置时：production=true、其他=false；局域网 HTTP 调试可显式设 false）
# - NODE_ENV：生产必须显式设 production（否则 CORS fail-fast 与 Secure 默认不生效）；本文件默认不设，保持开发态
# - TRUST_PROXY：经 Nginx 等可信反代时设 1（让 req.ip 取 X-Forwarded-For）；直连不要设
# SESSION_TTL_DAYS=7
# COOKIE_SECURE=false
# NODE_ENV=production
# TRUST_PROXY=1

# 仅用于日志查看接口（GET /api/logs*）按「调度时区」取当天日期。
# 请与 cron-worker/.env 的 SCHEDULER_TIMEZONE 保持一致，否则按日期查询会出现偏差。
SCHEDULER_TIMEZONE=America/Toronto

# 本进程**不持有任何调度**（ADR-002：cron-worker 是唯一调度所有者）。
# SCHEDULER_ENABLED 与全部 *_CRON 表达式均已移至 cron-worker/.env。
