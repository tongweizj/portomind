# Required: MongoDB database used by the API, seed, and baseline verification.
MONGO_URI=mongodb://127.0.0.1:27017/portomind_dev

# Optional server settings.
PORT=8080
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=60d
CORS_ORIGINS=http://localhost:5173
MARKET_TIMEZONE=America/Toronto
MARKET_DATA_TIMEOUT_MS=10000

# The Node API process is the single scheduler owner. Disable this on every
# additional PM2/cluster worker; do not also configure system cron.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Toronto
PRICE_SYNC_CRON=0 3 * * *
